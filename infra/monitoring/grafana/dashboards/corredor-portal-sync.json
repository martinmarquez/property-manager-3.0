{
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Corredor CRM — Portal sync error rate monitoring (target: < 1%)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Portal Sync Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 0.05,
          "mappings": [{ "options": { "match": "null", "result": { "index": 0, "text": "No data" } }, "type": "special" }]
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": true, "showThresholdMarkers": true },
      "title": "1-hour Error Rate",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "sum(rate(corredor_portal_sync_total{status=\"failed\"}[1h])) / sum(rate(corredor_portal_sync_total[1h]))",
          "legendFormat": "Error rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Dead-Letter Queue Size",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "bullmq_queue_failed_count{queue_name=\"dead-letter\"}",
          "legendFormat": "DLQ jobs",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Syncs in Last Hour",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "sum(increase(corredor_portal_sync_total[1h]))",
          "legendFormat": "Total syncs",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "P95 Sync Duration",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "histogram_quantile(0.95, sum by(le) (rate(corredor_portal_sync_duration_seconds_bucket[1h])))",
          "legendFormat": "P95",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Error Rate Trend",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percentunit",
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SLA limit (1%)" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "id": 5,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Portal Sync Error Rate (1h window)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "sum(rate(corredor_portal_sync_total{status=\"failed\"}[1h])) / sum(rate(corredor_portal_sync_total[1h]))",
          "legendFormat": "Error rate (all portals)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "sum by(portal_name) (rate(corredor_portal_sync_total{status=\"failed\"}[1h])) / sum by(portal_name) (rate(corredor_portal_sync_total[1h]))",
          "legendFormat": "{{ portal_name }}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "vector(0.01)",
          "legendFormat": "SLA limit (1%)",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 102,
      "title": "Sync Volume by Portal",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 21 },
      "id": 6,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "title": "Sync Throughput by Portal",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "sum by(portal_name) (rate(corredor_portal_sync_total[5m]))",
          "legendFormat": "{{ portal_name }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 21 },
      "id": 7,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "title": "Sync Failures by Portal",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "sum by(portal_name) (rate(corredor_portal_sync_total{status=\"failed\"}[5m]))",
          "legendFormat": "{{ portal_name }} failures",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["portal-sync", "monitoring", "production"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "America/Argentina/Buenos_Aires",
  "title": "Corredor — Portal Sync Monitoring",
  "uid": "corredor-portal-sync",
  "version": 1
}
