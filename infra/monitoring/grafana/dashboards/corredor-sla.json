  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["sla", "uptime", "production"],
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "America/Argentina/Buenos_Aires",
  "title": "Corredor — SLA Uptime",
  "uid": "corredor-sla",
  "version": 1
