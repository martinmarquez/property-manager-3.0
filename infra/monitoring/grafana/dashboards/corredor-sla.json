    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "SLA Budget Burn",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SLA 99.9%" },
            "properties": [{ "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "SLA 99.95%" },
            "properties": [{ "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "id": 5,
      "options": { "legend": { "calcs": ["mean", "min", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "API Uptime Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "avg_over_time(probe_success{job=\"blackbox_http\", instance=\"https://api.corredor.ar/v1/health\"}[5m])",
          "legendFormat": "API health (5m avg)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "vector(0.999)",
          "legendFormat": "SLA 99.9%",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "corredor-prometheus" },
          "expr": "vector(0.9995)",
          "legendFormat": "SLA 99.95%",
          "refId": "C"
        }
      ]
    }
